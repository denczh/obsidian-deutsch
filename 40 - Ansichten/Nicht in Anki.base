filters:
  and:
    - 'note.type == "vocab"'
    - 'note.anki == false'
    - 'note.status != "new"'
views:
  - type: table
    name: Nicht in Anki
    order:
      - file.name
      - note.article
      - note.translation
      - note.cefr
      - note.status
    sort:
      - property: note.cefr
        direction: ASC
      - property: file.name
        direction: ASC
