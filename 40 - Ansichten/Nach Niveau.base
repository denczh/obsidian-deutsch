filters:
  or:
    - note.type == "vocab"
    - note.type == "grammar"
views:
  - type: table
    name: Nach Niveau
    order:
      - cefr
      - file.name
      - type
      - pos
      - sense
      - lektion
      - translation
    sort:
      - property: cefr
        direction: ASC
      - property: file.name
        direction: ASC
