filters:
  or:
    - 'note.type == "vocab"'
    - 'note.type == "grammar"'
views:
  - type: table
    name: Nach Niveau
    order:
      - note.cefr
      - file.name
      - note.type
      - note.pos
      - note.sense
      - note.lektion
      - note.translation
      - note.status
    sort:
      - property: note.cefr
        direction: ASC
      - property: file.name
        direction: ASC
