filters:
  and:
    - note.error_count > 0
    - note.status != "known"
    - or:
        - note.type == "vocab"
        - note.type == "grammar"
views:
  - type: table
    name: Schwachstellen
    order:
      - file.name
      - type
      - pos
      - sense
      - cefr
      - last_error
      - error_count
      - status
      - translation
    sort:
      - property: last_error
        direction: DESC
      - property: error_count
        direction: DESC
