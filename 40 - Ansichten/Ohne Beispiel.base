filters:
  and:
    - '!file.inFolder("90 - Vorlagen")'
    - note.type == "vocab"
    - or:
        - note.example == ""
        - note.example == null
views:
  - type: table
    name: Ohne Beispiel
    order:
      - file.name
      - cefr
      - translation
      - created
    sort:
      - property: created
        direction: ASC
