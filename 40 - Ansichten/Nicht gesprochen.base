filters:
  and:
    - note.type == "vocab"
    - note.source != "voice-session"
    - note.status == "new"
views:
  - type: table
    name: Nicht gesprochen
    order:
      - file.name
      - source
      - pos
      - article
      - inflection
      - translation
      - example
      - created
    sort:
      - property: created
        direction: ASC
