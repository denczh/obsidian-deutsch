filters:
  or:
    - note.type == "vocab"
    - note.type == "grammar"
views:
  - type: table
    name: Nach Thema
    order:
      - theme
      - file.name
      - type
      - cefr
      - translation
    sort:
      - property: cefr
        direction: ASC
      - property: theme
        direction: ASC
      - property: file.name
        direction: ASC
