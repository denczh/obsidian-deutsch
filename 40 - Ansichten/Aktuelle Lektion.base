filters:
  and:
    - note.lektion == "L002"
    - or:
        - note.type == "vocab"
        - note.type == "grammar"
views:
  - type: table
    name: Aktuelle Lektion
    order:
      - file.name
      - type
      - cefr
      - pos
      - article
      - translation
      - created
    sort:
      - property: created
        direction: DESC
