filters:
  and:
    - 'note.lektion == "L001"'
    - or:
        - 'note.type == "vocab"'
        - 'note.type == "grammar"'
views:
  - type: table
    name: Aktuelle Lektion
    order:
      - file.name
      - note.type
      - note.cefr
      - note.pos
      - note.article
      - note.translation
      - note.status
      - note.created
    sort:
      - property: note.created
        direction: DESC
